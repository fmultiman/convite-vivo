# URL pública base (canonical e Open Graph). Em produção, o domínio aprovado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rota /preview/[slug] para rascunhos. Sempre ligada em `next dev`.
# Em build de produção só com valor "true" (lido no build: exige novo build para mudar).
# Use apenas em ambiente protegido — a prévia expõe dados ainda não confirmados.
ENABLE_DRAFT_PREVIEW=false
