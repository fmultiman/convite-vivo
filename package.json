{
  "name": "convite-vivo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "schema": "node scripts/generate-schema.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run safety && npm test && npm run build",
    "assets:scene-01": "node scripts/build-scene-assets.mjs maite-1-ano/scene-01",
    "safety": "node scripts/check-public-safety.mjs",
    "assets:scene-02": "node scripts/build-scene-assets.mjs maite-1-ano/scene-02",
    "assets:scene-03-private": "node scripts/build-scene-assets.mjs maite-1-ano/scene-03-private"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
